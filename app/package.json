    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@zorsh/zorsh": "^0.5.2",
    "ajv": "^8.20.0",
    "hono": "^4.13.18",
    "near-kit": "^0.20.2",
    "re2js": "2.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@rsbuild/core": "^2.3.2",
