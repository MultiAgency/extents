#!/usr/bin/env bash
# Every check this repository has, cheapest first, one line each, then `next:` with what to fix first.
#
#   scripts/check            the checks CI runs
#   scripts/check --sandbox  also the Docker sandbox tests, on EXTENTS_OBJECTIVE_WASM if set
#
# A stage's full output is kept in a log, named on its line when it fails, and removed when all pass.
# The app's unit and browser tests are skipped when it does not typecheck: their failures would only
# restate that one.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
logs="$(mktemp -d "${TMPDIR:-/tmp}/extents-check.XXXXXX")"
sandbox=false
for arg in "$@"; do
  case "$arg" in
    --sandbox) sandbox=true ;;
    *) echo "usage: scripts/check [--sandbox]" >&2; exit 2 ;;
  esac
done

first_failure=""
failed() { [[ -n "$first_failure" ]]; }

# stage <name> <dir> <command...>
stage() {
  local name="$1" dir="$2"
  shift 2
  local log="$logs/$name.log" start=$SECONDS
  if (cd "$root/$dir" && "$@") >"$log" 2>&1; then
    printf '✓ %-14s %3ss\n' "$name" "$((SECONDS - start))"
    return 0
  fi
  printf '✗ %-14s %3ss  %s\n' "$name" "$((SECONDS - start))" "$log"
  [[ -n "$first_failure" ]] || first_failure="$name"
  return 1
}
skip() { printf -- '- %-14s       %s\n' "$1" "$2"; }

stage rules app pnpm exec vitest run test/rules.test.ts
stage fmt . cargo fmt --all -- --check
stage clippy . cargo clippy --workspace --all-targets -- -D warnings
stage clippy-wasm . cargo clippy -p extents-objective --target wasm32-unknown-unknown --features=contract -- -D warnings
stage rust-tests . cargo test --workspace
if stage typecheck app pnpm typecheck; then
  stage unit app pnpm test
  stage browser app pnpm test:e2e
else
  skip unit "the app does not typecheck"
  skip browser "the app does not typecheck"
fi
if $sandbox; then
  stage sandbox . cargo nextest run -p extents-sandbox --run-ignored only
else
  skip sandbox "needs Docker: scripts/check --sandbox"
fi

case "$first_failure" in
  "") echo "next: all green" ;;
  rules) echo "next: a rule in docs/spec.md has no test citing it, or a citation or link names no heading; see the log" ;;
  fmt) echo "next: run cargo fmt --all" ;;
  clippy | clippy-wasm) echo "next: fix the clippy findings in the log; never silence one without a reason" ;;
  rust-tests) echo "next: fix the failing Rust test in the log; a failing vector means a format changed (AGENTS.md)" ;;
  typecheck) echo "next: fix the type errors in the log" ;;
  unit | browser) echo "next: fix the failing app test in the log" ;;
  sandbox) echo "next: read the sandbox log; an RPC error with no failed assertion is host load, so rerun before debugging" ;;
esac
# the logs are only worth keeping for a failure to read
failed && exit 1
rm -rf "$logs"
